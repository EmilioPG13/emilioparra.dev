---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import overpassLatin from '@fontsource-variable/overpass/files/overpass-latin-wght-normal.woff2?url';
import overpassMonoLatin from '@fontsource-variable/overpass-mono/files/overpass-mono-latin-wght-normal.woff2?url';

import { person, analytics } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Pages that should stay out of search results (the 404). */
  noindex?: boolean;
  /** Structured data for the page, serialized as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Cookieless analytics, limited to the real domain so previews and localhost are not counted. -->
    {
      analytics.websiteId && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={analytics.websiteId}
          data-domains={analytics.domain}
        />
      )
    }

    <!-- The two faces the first screen needs, so the text does not reflow when they arrive. -->
    <link rel="preload" href={overpassLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={overpassMonoLatin} as="font" type="font/woff2" crossorigin />

    <!--
      Must run before the first paint, so it is inline and not a module:
      otherwise the page flashes the wrong theme. A stored choice (written only
      when the reader clicks the toggle) wins; otherwise follow the OS setting
      and keep following it if it changes while the tab is open.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = matchMedia('(prefers-color-scheme: dark)');
        const readStored = () => {
          try {
            const value = localStorage.getItem('theme');
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null; // storage can throw in some private modes
          }
        };
        const apply = (theme) => {
          root.dataset.theme = theme;
        };
        apply(readStored() ?? (media.matches ? 'dark' : 'light'));
        media.addEventListener('change', (event) => {
          if (!readStored()) apply(event.matches ? 'dark' : 'light');
        });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-sign focus:px-3 focus:py-2 focus:text-sign-ink"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
