---
import { person, newTab } from '../data/site';
---

<section id="contact" aria-labelledby="contact-title" class="on-band bg-accent text-on-accent">
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20" data-reveal>
    <h2 id="contact-title" class="text-4xl font-extrabold sm:text-6xl">Contact</h2>
    <p class="mt-3 max-w-[40ch] text-lg text-on-accent/80">
      The fastest way to know if I fit is the CV. To talk, write to me.
    </p>

    <div class="mt-8 flex flex-col items-start gap-6">
      <a
        href={person.cv}
        download
        data-umami-event="download-cv"
        data-umami-event-location="contact"
        class="inline-flex min-h-14 items-center gap-4 bg-on-accent px-6 text-lg font-bold text-accent no-underline transition-transform duration-200 hover:-translate-y-0.5"
      >
        <span>Download CV</span>
        <span class="num text-sm font-semibold opacity-80">PDF</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
          <path d="M12 4v12M6 11l6 6 6-6M5 21h14"></path>
        </svg>
      </a>

      <a href={`mailto:${person.email}`} class="text-2xl font-bold sm:text-3xl">{person.email}</a>

      <ul class="flex flex-wrap gap-x-8 gap-y-1 text-lg font-semibold">
        <li>
          <a href={person.linkedin} {...newTab} class="inline-flex min-h-11 items-center">
            LinkedIn<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={person.github} {...newTab} class="inline-flex min-h-11 items-center">
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>

      <p class="flex flex-wrap items-center gap-x-2 text-base text-on-accent/80">
        <span>Prefer a call? Book on</span>
        {
          person.calls.map((call, index) => (
            <Fragment>
              {index > 0 && <span>or</span>}
              <a href={call.href} {...newTab} class="inline-flex min-h-11 items-center px-1 font-semibold text-on-accent">
                {call.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </Fragment>
          ))
        }
      </p>
    </div>
  </div>
</section>
