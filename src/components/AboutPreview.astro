---
import Arrow from './Arrow.astro';
---

<section id="about" aria-labelledby="about-title" class="mx-auto max-w-6xl px-4 pb-6 pt-10 sm:px-6 sm:pt-16">
  <div class="grid gap-6 border-t-[3px] border-ink pt-8 md:grid-cols-[14rem_1fr] md:gap-10">
    <h2 id="about-title" class="text-3xl font-extrabold sm:text-4xl">About</h2>
    <div>
      <p class="max-w-[48ch] text-xl leading-relaxed sm:text-2xl sm:leading-relaxed">
        I came to software through marketing and interpreting. I worked as a remote interpreter while I studied
        marketing, started learning to code in 2021, and kept going because the more I learned about how software is
        built, the more it interested me. I test everything, and when something fails I write the failure down and
        keep going until it passes.
      </p>
      <p class="mt-4">
        <a href="/about" class="inline-flex min-h-11 items-center gap-2 text-lg font-bold">
          More about me
          <Arrow />
        </a>
      </p>
    </div>
  </div>
</section>
