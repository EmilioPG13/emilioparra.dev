---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import LanguageIcon from './LanguageIcon.astro';
import { person, languages, newTab } from '../data/site';

// The last word of the sentence carries a line that draws itself once.
const pitch = person.pitch.replace(/(tests)\.$/, '<span class="draw">$1</span>.');
---

<section aria-labelledby="hero-name" class="mx-auto max-w-4xl px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-14">
  <div class="rise flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
    <Image
      src={headshot}
      alt="Emilio Parra"
      width={144}
      height={144}
      densities={[1.5, 2]}
      fit="cover"
      position="top"
      loading="eager"
      class="size-28 shrink-0 rounded-full border-2 border-ink object-cover transition-transform duration-300 ease-out hover:scale-105 sm:size-36"
    />
    <div>
      <h1 id="hero-name" class="text-[clamp(3rem,10vw,4.75rem)] font-extrabold leading-[0.95] tracking-tight">
        {person.name}
      </h1>
      <p class="mt-3 text-[clamp(1.25rem,3.5vw,1.75rem)] font-semibold text-ink-muted">{person.role}</p>
    </div>
  </div>

  <p
    class="rise mt-10 max-w-[28ch] text-[clamp(1.75rem,4.6vw,2.75rem)] font-bold leading-[1.12]"
    style="--d: 120ms"
    set:html={pitch}
  />

  <ul class="rise mt-6 flex flex-wrap gap-x-6 gap-y-1" aria-label="Main languages" style="--d: 220ms">
    {
      languages.map((lang) => (
        <li>
          <a href={lang.href} class="group inline-flex min-h-11 items-center gap-2 no-underline">
            <span
              class="grid size-8 place-items-center rounded-full bg-ink text-page transition-transform duration-200 ease-out group-hover:-translate-y-0.5"
              aria-hidden="true"
            >
              <LanguageIcon name={lang.name} />
            </span>
            <span class="text-lg font-semibold group-hover:underline">{lang.name}</span>
            <span class="sr-only">Used in {lang.used}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="rise mt-8 flex flex-col items-start gap-5" style="--d: 320ms">
    <a
      href={person.cv}
      download
      data-umami-event="download-cv"
      data-umami-event-location="hero"
      class="group inline-flex min-h-14 items-center gap-4 bg-ink px-6 text-lg font-bold text-page no-underline transition-colors hover:bg-accent hover:text-on-accent"
    >
      <span>Download CV</span>
      <span class="num text-sm font-semibold opacity-80">PDF</span>
      <svg class="transition-transform duration-200 ease-out group-hover:translate-y-0.5" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
        <path d="M12 4v12M6 11l6 6 6-6M5 21h14"></path>
      </svg>
    </a>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      <a href={`mailto:${person.email}`} class="text-lg font-semibold">{person.email}</a>
      <ul class="flex items-center gap-1" aria-label="Profiles">
        <li>
          <a href={person.github} {...newTab} aria-label="GitHub profile (opens in a new tab)" class="grid size-11 place-items-center rounded-full transition-colors hover:bg-ink hover:text-page">
            <svg width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={person.linkedin} {...newTab} aria-label="LinkedIn profile (opens in a new tab)" class="grid size-11 place-items-center rounded-full transition-colors hover:bg-ink hover:text-page">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 9h4v12H3zM5 3a2.2 2.2 0 1 1 0 4.4A2.2 2.2 0 0 1 5 3zM9.5 9h3.8v1.7c.6-1 1.9-2 3.9-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V21h-4z"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
