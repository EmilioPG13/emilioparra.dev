---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import EventMap from './EventMap.astro';
import Arrow from './Arrow.astro';
import { person, languages } from '../data/site';
---

<section aria-labelledby="hero-name">
  <!-- Signage band: the name, the role and the languages as line bullets. -->
  <div class="on-sign border-b border-rule bg-sign text-sign-ink">
    <div class="mx-auto max-w-6xl px-4 pb-8 pt-4 sm:px-6 sm:pb-8 sm:pt-6">
      <h1 id="hero-name" class="text-[clamp(3rem,12vw,6rem)] font-extrabold leading-[0.95] tracking-tight">
        {person.name}
      </h1>
      <p class="mt-2 text-[clamp(1.35rem,4vw,2rem)] font-semibold">{person.role}</p>

      <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1" aria-label="Main languages">
        {
          languages.map((lang) => (
            <li>
              <a href={lang.href} class="group inline-flex min-h-11 items-center gap-2 no-underline">
                <span
                  class="grid size-8 place-items-center rounded-full bg-sign-ink text-base font-extrabold text-sign"
                  aria-hidden="true"
                >
                  {lang.name[0]}
                </span>
                <span class="text-lg font-semibold group-hover:underline">{lang.name}</span>
                <span class="sr-only">Used in {lang.used}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Platform: the sentence, the person, the next action, and the map. -->
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
    <div>
      <p class="max-w-[22ch] text-[clamp(1.6rem,4.6vw,2.5rem)] font-bold leading-[1.12]">
        {person.pitch}
      </p>
      <p class="mt-3">
        <a href="#projects" class="inline-flex min-h-11 items-center gap-2 text-lg font-bold">
          See how each claim is proven
          <Arrow />
        </a>
      </p>

      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center">
        <Image
          src={headshot}
          alt="Emilio Parra"
          width={144}
          height={144}
          densities={[1.5, 2]}
          fit="cover"
          position="top"
          loading="eager"
          class="size-28 shrink-0 rounded-full border-2 border-ink object-cover sm:size-36"
        />

        <div class="flex flex-col items-start gap-4">
          <a
            href={person.cv}
            download
            class="group inline-flex min-h-14 items-center gap-4 border-2 border-ink bg-sign px-5 text-lg font-bold text-sign-ink no-underline hover:bg-platform hover:text-ink dark:bg-ink dark:text-platform dark:hover:bg-platform dark:hover:text-ink"
          >
            <span>Download CV</span>
            <span class="num text-sm font-semibold opacity-80">PDF</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
              <path d="M12 4v12M6 11l6 6 6-6M5 21h14"></path>
            </svg>
          </a>

          <a href={`mailto:${person.email}`} class="text-lg font-semibold">{person.email}</a>

          <ul class="flex items-center gap-1 text-ink" aria-label="Profiles">
            <li>
              <a href={person.github} aria-label="GitHub profile" class="grid size-11 place-items-center rounded-full hover:bg-ink hover:text-platform">
                <svg width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                </svg>
              </a>
            </li>
            <li>
              <a href={person.linkedin} aria-label="LinkedIn profile" class="grid size-11 place-items-center rounded-full hover:bg-ink hover:text-platform">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3 9h4v12H3zM5 3a2.2 2.2 0 1 1 0 4.4A2.2 2.2 0 0 1 5 3zM9.5 9h3.8v1.7c.6-1 1.9-2 3.9-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V21h-4z"></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div>
      <EventMap />
    </div>
  </div>
</section>
