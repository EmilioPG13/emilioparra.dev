---
import { featured, shortLines, newTab } from '../data/site';
import Arrow from './Arrow.astro';
---

<section id="projects" aria-labelledby="projects-title" class="pb-6">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="border-t-[3px] border-ink pt-8">
      <h2 id="projects-title" class="text-3xl font-extrabold sm:text-4xl">Projects</h2>
      <p class="mt-3 max-w-[55ch] text-lg text-ink-muted">
        Two systems built to stay correct when things fail, and two shorter ones. Every claim links to the test or document behind it.
      </p>
    </div>
  </div>

  {
    featured.map((project) => (
      <article
        id={project.id}
        aria-labelledby={`${project.id}-title`}
        class="mx-auto mt-10 max-w-6xl scroll-mt-20 px-4 sm:mt-14 sm:px-6"
      >
        <div class="grid gap-8 border-t border-rule pt-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
          <div>
            <h3 id={`${project.id}-title`} class="text-[clamp(1.5rem,3vw,2rem)] font-extrabold leading-tight">
              {project.name}
            </h3>
            <p class="mt-2 text-base text-ink-muted">{project.stack}</p>
            <p class="mt-5 max-w-[34ch] text-xl font-semibold leading-snug">{project.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-1">
              {project.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...newTab}
                    class="inline-flex min-h-11 items-center gap-1 text-lg font-bold"
                  >
                    {link.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                    <Arrow />
                  </a>
                </li>
              ))}
            </ul>
            {project.note && <p class="mt-1 max-w-[44ch] text-base text-ink-muted">{project.note}</p>}
          </div>

          <ol class="divide-y divide-rule" aria-label={`Evidence for ${project.name}`}>
            {project.evidence.map((item) => (
              <li class="py-5 first:pt-0 last:pb-0">
                <h4 class="text-lg font-bold leading-snug">{item.title}</h4>
                <p class="mt-1 max-w-[60ch] text-ink-muted">{item.text}</p>
                {item.proof && (
                  <p class="mt-2">
                    <a href={item.proof.href} {...newTab} class="link font-semibold">
                      {item.proof.label}
                      <span class="sr-only"> for {item.title} (opens in a new tab)</span>
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ol>
        </div>
      </article>
    ))
  }

  <div class="mx-auto mt-14 max-w-6xl px-4 sm:mt-20 sm:px-6">
    <h3 class="text-2xl font-extrabold">Also built</h3>
    <ul class="mt-4 border-t-[3px] border-ink">
      {
        shortLines.map((project) => (
          <li
            id={project.id}
            class="grid gap-3 border-b border-rule py-6 md:grid-cols-[14rem_1fr_auto] md:gap-8"
          >
            <h4 class="text-xl font-extrabold">{project.name}</h4>
            <div>
              <p class="max-w-[60ch]">{project.summary}</p>
              <p class="mt-1 text-base text-ink-muted">{project.stack}</p>
              {project.note && <p class="mt-1 text-base text-ink-muted">{project.note}</p>}
            </div>
            <ul class="flex flex-wrap gap-x-6 md:flex-col md:gap-x-0">
              {project.links.map((link) => (
                <li>
                  <a href={link.href} {...newTab} class="inline-flex min-h-11 items-center gap-1 font-bold">
                    {link.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                    <Arrow />
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
