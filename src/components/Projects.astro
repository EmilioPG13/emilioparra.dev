---
import { featured, shortLines, newTab } from '../data/site';
import Arrow from './Arrow.astro';

// A soft wash of the project's own hue on hover.
const wash = 'hover:bg-[color-mix(in_srgb,var(--c)_8%,transparent)]';
---

<section id="projects" aria-labelledby="projects-title" class="pb-6">
  <div class="mx-auto max-w-4xl px-4 sm:px-6" data-reveal>
    <div class="border-t-[3px] border-ink pt-8">
      <h2 id="projects-title" class="text-3xl font-extrabold sm:text-4xl">Projects</h2>
      <p class="mt-3 max-w-[55ch] text-lg text-ink-muted">
        Two systems built to stay correct when things fail, and two shorter ones. Every claim links to the test or document behind it.
      </p>
    </div>
  </div>

  {
    featured.map((project) => (
      <article
        id={project.id}
        aria-labelledby={`${project.id}-title`}
        data-reveal
        class="project mx-auto mt-8 max-w-4xl scroll-mt-20 px-4 sm:mt-12 sm:px-6"
        style={`--c: var(--hue-${project.hue})`}
      >
        <div class={`-mx-3 border-t border-rule px-3 pb-8 pt-8 transition-colors duration-300 ${wash}`}>
          <h3 id={`${project.id}-title`} class="project-name inline text-[clamp(1.5rem,3vw,2rem)] font-extrabold leading-tight">
            {project.name}
          </h3>
          <p class="mt-3 text-base text-ink-muted">{project.stack}</p>
          <p class="mt-4 max-w-[40ch] text-xl font-semibold leading-snug">{project.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
            {project.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...newTab}
                  class="group inline-flex min-h-11 items-center gap-1 text-lg font-bold"
                >
                  {link.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ul>
          {project.note && <p class="mt-1 max-w-[52ch] text-base text-ink-muted">{project.note}</p>}

          <ol class="mt-6 divide-y divide-rule border-t border-rule" aria-label={`Evidence for ${project.name}`}>
            {project.evidence.map((item) => (
              <li class="grid gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-8">
                <h4 class="font-bold leading-snug">{item.title}</h4>
                <div>
                  <p class="max-w-[60ch] text-ink-muted">{item.text}</p>
                  {item.proof && (
                    <p class="mt-1">
                      <a href={item.proof.href} {...newTab} class="link font-semibold">
                        {item.proof.label}
                        <span class="sr-only"> for {item.title} (opens in a new tab)</span>
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>
    ))
  }

  <div class="mx-auto mt-12 max-w-4xl px-4 sm:mt-16 sm:px-6" data-reveal>
    <h3 class="text-2xl font-extrabold">Also built</h3>
    <ul class="mt-4 border-t-[3px] border-ink">
      {
        shortLines.map((project) => (
          <li
            id={project.id}
            class="project border-b border-rule"
            style={`--c: var(--hue-${project.hue})`}
          >
            <div class={`-mx-3 grid gap-3 px-3 py-6 transition-colors duration-300 md:grid-cols-[14rem_1fr_auto] md:gap-8 ${wash}`}>
              <h4 class="text-xl font-extrabold">
                <span class="project-name">{project.name}</span>
              </h4>
              <div>
                <p class="max-w-[60ch]">{project.summary}</p>
                <p class="mt-1 text-base text-ink-muted">{project.stack}</p>
                {project.note && <p class="mt-1 text-base text-ink-muted">{project.note}</p>}
              </div>
              <ul class="flex flex-wrap gap-x-6 md:flex-col md:gap-x-0">
                {project.links.map((link) => (
                  <li>
                    <a href={link.href} {...newTab} class="group inline-flex min-h-11 items-center gap-1 font-bold">
                      {link.label}
                      <span class="sr-only"> (opens in a new tab)</span>
                      <Arrow />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
