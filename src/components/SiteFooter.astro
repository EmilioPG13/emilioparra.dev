---
import { person, newTab } from '../data/site';
---

<footer class="text-ink-muted">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 text-base sm:px-6">
    <p>{person.name}, Puebla, Mexico. Open to remote roles with US teams.</p>
    <ul class="flex gap-6">
      <li>
        <a href={person.github} {...newTab} class="inline-flex min-h-11 items-center text-ink">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
      </li>
      <li>
        <a href={person.linkedin} {...newTab} class="inline-flex min-h-11 items-center text-ink">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
      </li>
    </ul>
  </div>
</footer>
