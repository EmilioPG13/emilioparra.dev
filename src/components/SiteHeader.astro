---
import { person } from '../data/site';

const nav = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="on-sign bg-sign text-sign-ink">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a
      href="/"
      class="grid size-10 shrink-0 place-items-center rounded-full bg-sign-ink text-sign text-[0.95rem] font-extrabold tracking-tight no-underline"
      aria-label={`${person.name}, home`}
    >
      EP
    </a>

    <nav aria-label="Main" class="ml-auto">
      <ul class="flex items-center gap-1 sm:gap-3">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center px-2 text-[0.95rem] font-semibold no-underline hover:underline sm:px-3"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="theme-toggle"
      class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-sign-muted/50 hover:border-sign-ink"
      aria-label="Dark theme"
      aria-pressed="false"
    >
      <!-- Shown while the light theme is active: pressing it switches to dark. -->
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .icon-sun {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const sync = () => {
    button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  };

  // A choice is stored only when the reader clicks. Until then the page keeps
  // following the system setting (see the inline script in Layout.astro).
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can throw in some private modes; the toggle still works for this visit.
    }
    sync();
  });

  // Keeps the pressed state right when the system theme changes with the tab open.
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  sync();
</script>
