---

<span class="grid place-items-center" style={`width:${mark.size}px;height:${mark.size}px`}>
  <svg
    class="col-start-1 row-start-1 size-full transition-opacity duration-200 ease-out group-hover:opacity-0 group-focus-visible:opacity-0"
    viewBox={mark.monoBox}
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={mark.mono}></path>
  </svg>
  <svg
    class="col-start-1 row-start-1 size-full opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100 group-focus-visible:opacity-100"
    viewBox={mark.colorBox}
    aria-hidden="true"
    set:html={mark.color}
  />
</span>
