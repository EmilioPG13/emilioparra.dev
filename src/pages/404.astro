---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---

<Layout title="Page not found | Emilio Parra" description="This page does not exist." noindex>
  <section class="mx-auto max-w-4xl px-4 pb-6 pt-10 sm:px-6 sm:pt-16">
    <p class="num text-[clamp(3rem,12vw,6rem)] font-bold leading-none text-ink-muted" aria-hidden="true">404</p>
    <h1 class="mt-2 text-[clamp(1.6rem,5vw,2.5rem)] font-extrabold">This page is not here.</h1>
    <p class="mt-4 max-w-[50ch] text-lg">The page you opened does not exist, or it moved.</p>
    <ul class="mt-4 flex flex-wrap gap-x-8 pb-16">
      <li>
        <a href="/" class="group inline-flex min-h-11 items-center gap-2 text-lg font-bold">
          Back to the home page
          <Arrow />
        </a>
      </li>
      <li>
        <a href="/#projects" class="group inline-flex min-h-11 items-center gap-2 text-lg font-bold">
          See the projects
          <Arrow />
        </a>
      </li>
    </ul>
  </section>
</Layout>
