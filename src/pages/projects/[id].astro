---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import { newTab } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, line, links, facts } = project.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: summary,
  author: { '@type': 'Person', name: 'Emilio Parra' },
};
---

<Layout title={`${title} | Emilio Parra`} description={summary} jsonLd={jsonLd}>
  <!-- Signage band in the project's line colour, as on the home map. -->
  <div class="on-sign border-b border-rule bg-sign text-sign-ink">
    <div class="mx-auto max-w-6xl px-4 pb-8 pt-4 sm:px-6 sm:pb-8 sm:pt-6">
      <p class="flex items-center gap-3 font-mono text-base font-semibold">
        <span aria-hidden="true" class="h-2 w-12" style={`background: var(--line-${line})`}></span>
        Case study
      </p>
      <h1 class="mt-3text-[clamp(2.5rem,9vw,5rem)] font-extrabold leading-[0.95] tracking-tight">{title}</h1>
      <p class="mt-3 max-w-[40ch] text-[clamp(1.2rem,3.5vw,1.75rem)] font-semibold">{summary}</p>
    </div>
  </div>

  <article class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14 lg:py-16">
    <div class="case-body max-w-[62ch]">
      <Content />
    </div>

    <aside class="space-y-10">
      {
        facts.length > 0 && (
          <section aria-labelledby="facts-title">
            <h2 id="facts-title" class="text-2xl font-extrabold">Numbers and where they come from</h2>
            <dl class="mt-4 border-t-[3px] border-ink">
              {facts.map((fact) => (
                <div class="border-b border-rule py-3">
                  <dt class="text-base text-ink-muted">{fact.label}</dt>
                  <dd class="text-lg font-bold">{fact.value}</dd>
                  {fact.context && <dd class="text-base text-ink-muted">{fact.context}</dd>}
                  <dd>
                    <a href={fact.source.href} {...newTab} class="inline-flex min-h-11 items-center font-semibold underline">
                      {fact.source.label}
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        links.length > 0 && (
          <ul class="space-y-1">
            {links.map((item) => (
              <li>
                <a href={item.href} {...newTab} class="inline-flex min-h-11 items-center gap-2 font-bold">
                  {item.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a href="/#projects" class="inline-flex min-h-11 items-center font-semibold underline">All projects</a>
    </aside>
  </article>
</Layout>
